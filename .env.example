# Dummy local credentials. Replace with unique secrets before exposing the service.
# Use URL-safe characters for POSTGRES_PASSWORD with this Compose configuration.
POSTGRES_PASSWORD=local-only
S3_ACCESS_KEY=stopkadr-local
S3_SECRET_KEY=stopkadr-local-storage-secret
S3_BUCKET=stopkadr-private
S3_REGION=us-east-1
FAKE_PAYMENT_SECRET=stopkadr-local-payment-demo-secret
PAYMENT_PROVIDER=fake
AI_PROVIDER=fake
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RECOGNITION_MODEL=gemini-3.5-flash-lite
GEMINI_HUMANITIES_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
AUTH_TOKEN_TTL_SECONDS=86400
LOG_LEVEL=INFO
MAX_FILE_BYTES=12582912
MAX_REQUEST_BYTES=33554432
MAX_PAGES=100
MAX_IMAGE_PIXELS=64000000
PAGE_IMAGE_EDGE=2000
MAX_ATTEMPTS=1
RETRY_DELAY_SECONDS=10
JOB_LEASE_SECONDS=180
WORKER_POLL_SECONDS=3
# Optional demo catalogue as one JSON array. Commercial conditions are unset by default.
# PLANS_JSON=[{"code":"demo","name":"Тестовый тариф","checks_limit":10,"max_pages":10,"allow_followups":true}]
