# Include from nginx http {}, after replacing the hostname and certificate paths.
# Traffic is accepted only from the explicitly added VPN or office CIDRs.
limit_req_zone $binary_remote_addr zone=pilot_auth:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=pilot_api:10m rate=8r/s;

server {
    listen 443 ssl;
    server_name pilot.example.invalid;

    ssl_certificate /etc/ssl/pilot/fullchain.pem;
    ssl_certificate_key /etc/ssl/pilot/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=86400" always;

    # Replace this documentation-only address with approved source ranges.
    allow 192.0.2.10/32;
    deny all;
    access_log off;

    client_max_body_size 32m;
    client_body_timeout 20s;
    limit_req_status 429;
    error_page 413 = @request_too_large;
    error_page 429 = @rate_limited;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $server_name;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Real-IP "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_connect_timeout 3s;
    proxy_send_timeout 65s;
    proxy_read_timeout 65s;

    location = /v1/payments/webhook { return 404; }

    location ~ ^/v1/auth/(login|register)/?$ {
        limit_req zone=pilot_auth burst=6 nodelay;
        proxy_pass http://127.0.0.1:5173;
    }
    location /v1/ {
        limit_req zone=pilot_api burst=24 nodelay;
        proxy_pass http://127.0.0.1:5173;
    }
    location / {
        proxy_pass http://127.0.0.1:5173;
    }

    location @request_too_large {
        default_type application/json;
        return 413 '{"error":{"code":"request_too_large","message":"Запрос превышает допустимый размер."}}';
    }
    location @rate_limited {
        default_type application/json;
        return 429 '{"error":{"code":"rate_limited","message":"Слишком много запросов. Повторите позже."}}';
    }
}
